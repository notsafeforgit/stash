{
  "name": "stash-ui-v3",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "homepage": "./",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "scripts": {
    "dev": "pnpm run gqlgen && pnpm run gen-settings-index && vite",
    "build": "pnpm run gqlgen && pnpm run gen-settings-index && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome lint && pnpm run lint:contracts",
    "lint:fix": "biome lint --write",
    "check": "pnpm run gqlgen && pnpm run gen-settings-index && tsc --noEmit && pnpm run check:browser",
    "check:browser": "tsc --noEmit --project tests/browser/tsconfig.json",
    "format": "biome format --write",
    "format-check": "biome format",
    "check-i18n": "node scripts/check-i18n.mjs",
    "gen-settings-index": "node scripts/generate-settings-search-index.mjs && biome format --write src/components/settings/settings-search-index.gen.ts",
    "validate": "pnpm run lint && pnpm run check && pnpm run format-check && pnpm run check-i18n && pnpm run test:ci && pnpm run check-compatibility",
    "test": "pnpm run gqlgen && vitest",
    "gqlgen": "graphql-codegen --config codegen.ts",
    "test:ci": "vitest run",
    "test:browser": "pnpm run check && playwright test",
    "check-compatibility": "node scripts/check-compatibility.mjs",
    "lint:contracts": "eslint src tests/browser",
    "test:pwa": "pnpm run build && playwright test --config playwright.pwa.config.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.3.1",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@videojs/core": "10.0.0-rc.2",
    "@videojs/google-cast": "10.0.0-rc.2",
    "@videojs/hlsjs-video": "10.0.0-rc.2",
    "@videojs/media": "10.0.0-rc.2",
    "@videojs/react": "10.0.0-rc.2",
    "apollo-upload-client": "^20.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dashjs": "^5.2.1",
    "date-fns": "^4.4.0",
    "graphql": "^17.0.2",
    "graphql-tag": "^2.12.7",
    "graphql-ws": "^6.2.2",
    "i18n-iso-countries": "^7.14.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.47.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-intl": "^12.1.1",
    "react-photo-album": "^3.6.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/time": "^7.1.0",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
