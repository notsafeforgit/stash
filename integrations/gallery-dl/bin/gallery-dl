#!/usr/bin/env python3
"""Host convenience launcher; install only with the native worker handoff."""
import os
from pathlib import Path
import re
import shlex
import stat
import sys

environment = dict(os.environ)
filename = environment.get('STASH_INGEST_ENV_FILE', str(Path.home() / '.config/stash-ingest/host.env'))
try:
    fd = os.open(filename, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, 'r') as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ValueError('Private environment file required')
        body = stream.read(65537)
    if len(body) > 65536:
        raise ValueError('Environment file too large')
    for line in body.splitlines():
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        name, separator, raw = line.partition('=')
        name = name.strip()
        if not separator or not re.fullmatch(r'STASH_INGEST_[A-Z0-9_]+', name):
            raise ValueError('Unexpected environment setting')
        values = shlex.split(raw, comments=False)
        if len(values) > 1:
            raise ValueError('Quote environment values containing whitespace')
        value = values[0] if values else ''
        if value.startswith('__') and value.endswith('__'):
            raise ValueError('Native producer provisioning is incomplete')
        environment.setdefault(name, value)
    executable = Path(environment.get('STASH_INGEST_EXECUTABLE', ''))
    if not executable.is_absolute() or not executable.is_file():
        raise ValueError('Configure the installed native runtime')
    python = executable.parent / 'python'
    if not python.is_file():
        raise ValueError('The installed native runtime is unavailable')
except (OSError, UnicodeError, ValueError):
    raise SystemExit('Native manual download configuration is unavailable or incomplete; check the private host.env file') from None

code = 'from stash_ingest.manual import main; raise SystemExit(main())'
os.execve(python, [str(python), '-I', '-c', code, '--api-key-env', 'STASH_INGEST_API_KEY', *sys.argv[1:]], environment)
