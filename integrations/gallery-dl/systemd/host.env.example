# Copy to ~/.config/stash-ingest/host.env with mode 0600 at reviewed cutover.
# Use absolute paths. EnvironmentFile does not expand ~, $HOME or other variables.
STASH_INGEST_EXECUTABLE=/home/your-user/.local/share/stash-ingest/venv/bin/stash-ingest
STASH_INGEST_OUTBOX=/home/your-user/.local/state/stash-ingest/host.sqlite
STASH_INGEST_ENDPOINT=http://127.0.0.1:9999
STASH_INGEST_PRODUCER=replace-with-registered-producer-uuid
STASH_INGEST_PROFILES=/home/your-user/.config/stash-ingest/profiles.json
# Scoped Stash ingestion API token; website access stays in local profile refs.
STASH_INGEST_TOKEN=replace-with-scoped-stash-ingestion-token
