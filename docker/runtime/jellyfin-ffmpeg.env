# The Jellyfin FFmpeg build shared by the image, CI media tests and
# `make test-media-image`. Jellyfin's repository keeps earlier releases, so an
# exact version stays installable; bump it deliberately in this one place.
JELLYFIN_FFMPEG_VERSION=8.1.3-2
# Fingerprint of https://repo.jellyfin.org/jellyfin_team.gpg.key.
JELLYFIN_KEY_FINGERPRINT=4918AABC486CA052358D778D49023CD01DE21A7B
