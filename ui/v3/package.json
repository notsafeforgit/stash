{
  "name": "stash-ui-v3",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "homepage": "./",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "scripts": {
    "dev": "pnpm run gqlgen && pnpm run gen-settings-index && vite",
    "build": "pnpm run gqlgen && pnpm run gen-settings-index && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome lint && pnpm run lint:contracts",
    "lint:fix": "biome lint --write",
    "check": "pnpm run gqlgen && pnpm run gen-settings-index && tsc --noEmit && pnpm run check:browser",
    "check:watch": "pnpm run gqlgen && pnpm run gen-settings-index && tsc --noEmit --watch --preserveWatchOutput",
    "check:browser": "tsc --noEmit --project tests/browser/tsconfig.json",
    "format": "biome format --write",
    "format-check": "biome format",
    "check-i18n": "node scripts/check-i18n.mjs",
    "gen-settings-index": "node scripts/generate-settings-search-index.mjs && biome format --write src/components/settings/settings-search-index.gen.ts",
    "validate": "pnpm run check && pnpm run lint && pnpm run format-check && pnpm run check-i18n && pnpm run test:ci && pnpm run check-native-contracts",
    "validate:build": "pnpm run validate && vite build",
    "test": "pnpm run gqlgen && vitest",
    "gqlgen": "graphql-codegen --config codegen.ts",
    "test:ci": "vitest run",
    "test:browser": "pnpm run check && playwright test",
    "test:browser:shard": "pnpm run check && node tests/browser/shard.mjs",
    "check-native-contracts": "node scripts/check-native-contracts.mjs",
    "lint:contracts": "eslint src tests/browser tests/stack",
    "test:pwa": "pnpm run build && playwright test --config playwright.pwa.config.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "@videojs/core": "10.6.0",
    "@videojs/google-cast": "10.6.0",
    "@videojs/hlsjs-video": "10.6.0",
    "@videojs/media": "10.6.0",
    "@videojs/react": "10.6.0",
    "apollo-upload-client": "^20.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dashjs": "^5.3.0",
    "date-fns": "^4.4.0",
    "graphql": "^17.1.0",
    "graphql-tag": "^2.12.7",
    "graphql-ws": "^6.4.3",
    "i18n-iso-countries": "^7.14.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "^12.2.0",
    "react-photo-album": "^3.6.2",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.33.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@graphql-codegen/add": "^8.0.0",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/time": "^8.0.0",
    "@graphql-codegen/typed-document-node": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-operations": "^7.0.2",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-devtools": "^1.167.4",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
