{
  "name": "stash-ui-v3",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "homepage": "./",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "pnpm": {
    "overrides": {
      "@videojs/hlsjs-video@10.0.0-rc.2>hls.js": "1.6.16"
    }
  },
  "scripts": {
    "dev": "pnpm run gqlgen && pnpm run gen-settings-index && vite",
    "build": "pnpm run gqlgen && pnpm run gen-settings-index && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome lint && pnpm run lint:contracts",
    "lint:fix": "biome lint --write",
    "check": "pnpm run gqlgen && pnpm run gen-settings-index && tsc --noEmit && pnpm run check:browser",
    "check:browser": "tsc --noEmit --project tests/browser/tsconfig.json",
    "format": "biome format --write",
    "format-check": "biome format",
    "check-i18n": "node scripts/check-i18n.mjs",
    "gen-settings-index": "node scripts/generate-settings-search-index.mjs && biome format --write src/components/settings/settings-search-index.gen.ts",
    "validate": "pnpm run lint && pnpm run check && pnpm run format-check && pnpm run check-i18n && pnpm run test:ci && pnpm run check-compatibility",
    "test": "pnpm run gqlgen && vitest",
    "gqlgen": "graphql-codegen --config codegen.ts",
    "test:ci": "vitest run",
    "test:browser": "pnpm run check && playwright test",
    "check-compatibility": "node scripts/check-compatibility.mjs",
    "lint:contracts": "eslint src tests/browser"
  },
  "dependencies": {
    "@apollo/client": "^4.1.0",
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-router": "^1.168.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@videojs/core": "10.0.0-rc.2",
    "@videojs/google-cast": "10.0.0-rc.2",
    "@videojs/hlsjs-video": "10.0.0-rc.2",
    "@videojs/media": "10.0.0-rc.2",
    "@videojs/react": "10.0.0-rc.2",
    "apollo-upload-client": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "dashjs": "^5.2.0",
    "date-fns": "^4.1.0",
    "graphql": "^16.13.0",
    "graphql-tag": "^2.12.6",
    "graphql-ws": "^6.0.0",
    "i18n-iso-countries": "^7.14.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.7.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-intl": "^10.1.0",
    "react-photo-album": "^3.6.0",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.31.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/time": "^6.0.0",
    "@graphql-codegen/typed-document-node": "^5.0.0",
    "@graphql-codegen/typescript": "^4.0.0",
    "@graphql-codegen/typescript-operations": "^4.0.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.2.0",
    "@tanstack/router-devtools": "^1.166.0",
    "@tanstack/router-plugin": "^1.167.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.0"
  }
}
